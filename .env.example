# Copy to .env. Real credentials belong only on the Python server.
# setup_local.py generates NEO_API_TOKEN; provider credentials remain optional.
NEO_ENV=development
NEO_API_HOST=127.0.0.1
NEO_API_PORT=8765
NEO_API_TOKEN=
NEO_LLM_API_KEY=
NEO_TELEPHONY_API_KEY=
NEO_TELEPHONY_WEBHOOK_SECRET=
NEO_REPORTS_PATH=data/mobile_reports.sqlite3

# Paths may be absolute or relative to the Neo project root.
NEO_VOSK_MODEL_PATH=models/vosk_model
NEO_PIPER_MODEL_PATH=models/piper_model/en_US-lessac-medium.onnx
